{
  "name": "ai-roundtable-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "db:init": "node dist/init-db.js",
    "start": "node dist/server.js",
    "dev:web": "vite --config web/vite.config.ts",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:e2e": "playwright test --config playwright.stage5c.config.ts",
    "test:e2e:local-adapter": "playwright test --config playwright.stage6a.config.ts",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "config:check": "node dist/check-backend-config.js",
    "live:stage4d": "node dist/live-server.js",
    "config:stage6b": "node dist/check-stage6b-config.js",
    "prepare:stage6b": "node dist/prepare-stage6b.js",
    "live:stage6b": "node dist/live-stage6b.js",
    "typecheck:startup": "tsc -p tsconfig.startup.json --noEmit",
    "build:startup": "tsc -p tsconfig.startup.json",
    "launch:stage6b": "node .cache/startup/scripts/startup/stage6b.js",
    "rehearse:stage6b": "npm run build:startup && npm run launch:stage6b -- --local"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.63.0"
  }
}
