# Copy locally; fill the key only in the ignored .env.backend.local.
# Defaults are safe. Explicitly select deepseek and use --allow-real-models when you decide to make paid calls.
ROSTER_PROVIDER=fake
DISCUSSION_PROVIDER=fake
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MAX_TOKENS=4096
