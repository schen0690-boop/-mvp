# Copy to .env.backend.local and fill locally. Never send the key in chat.
ROSTER_PROVIDER=deepseek
# Independent discussion selection; not read by npm start (explicit Fake composition).
# A key/selection alone is NOT authorization. Stage 6A only injects a local HTTP stub.
DISCUSSION_PROVIDER=fake
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MAX_TOKENS=4096
